# Build output
build/
dist/
out/
target/
.gradle/
node_modules/

# Env / secrets (never commit)
.env
.env.*
!.env.example
*.local

# Editor / OS
.idea/
.vscode/
.DS_Store
*.swp

# Logs
*.log

# Planning and agent scratch artifacts belong in issues, PRs, or durable docs.
.specify/
specs/[0-9][0-9][0-9]-*/
plans/
planning/
scratchpad/
scratchpads/
.agent-council/
*scratchpad*.md
*.scratch.md
*agent-council*.md
tools/deploy-check/node_modules/

# Python bytecode. These were committed and then reported as modified on every
# test run, because .pyc embeds the source mtime and the interpreter version -
# so the repo was permanently dirty and every diff carried binary noise.
__pycache__/
*.py[cod]
